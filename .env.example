# Copy this file to ".env" and fill in your own Firebase project details.
# If you leave FIREBASE_DB_URL empty, the app automatically uses a local
# JSON file (data/records.json) instead, so it still runs for a demo.

FIREBASE_DB_URL=
FIREBASE_AUTH=

# Risk thresholds — keep these identical to the values used in the
# ESP32 firmware (Section 4.4/4.8) so the dashboard and hardware agree.
WATER_THRESHOLD=70
TEMP_MIN=20
TEMP_MAX=32
HUMIDITY_MIN=60
DANGER_LEVEL=2
CAUTION_LEVEL=1

FLASK_SECRET_KEY=change-this-in-production
