# Production environment variables
# Set these in Render (or your hosting provider), not in the repository.

# Required in production
FLASK_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False

# Optional Firebase Realtime Database
FIREBASE_DB_URL=
FIREBASE_AUTH=

# Risk thresholds
WATER_THRESHOLD=70
TEMP_MIN=20
TEMP_MAX=32
HUMIDITY_MIN=60
IMAGE_RISK_THRESHOLD=65
DANGER_LEVEL=2
CAUTION_LEVEL=1

# Storage
MAX_LOCAL_RECORDS=500
